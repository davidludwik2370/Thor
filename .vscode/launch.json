{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Odin (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/bin/debug",
      "cwd": "${workspaceFolder}",
      "args": [],
      "preLaunchTask": "build-odin-debug"
    },
    {
      "name": "Develop Thor VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}"
      ],
      "preLaunchTask": "Build TLS"
    }
  ]
}
