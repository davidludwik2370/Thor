#!/bin/sh
# Native bootstrap only. Binary installation needs neither Python nor Cargo.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
version=$(cat "$root/release/version")
bundle=
from_source=false
no_deps=false
reuse_odin=false
portable_bundle=false
editor=false
custom_code=false
maintenance=
prefix=
dry=false
checksum=
base=${THOR_RELEASE_BASE:-}
forward=$(mktemp -d "${TMPDIR:-/tmp}/thor-bootstrap.XXXXXXXX")
trap 'rm -rf "$forward"' EXIT HUP INT TERM
# Keep original arguments in "$@"; acquisition options are consumed below using
# a second pass before invoking the native installer.
for arg do
    case "$arg" in --help|-h)
        cat <<'HELP'
Thor installer (macOS/Linux)
Usage: ./thor-install [--vscode [--profile NAME]] [options]
  --bundle FILE          Use a local release bundle and FILE.sha256
  --sha256 HEX           Supply the expected SHA-256 explicitly
  --release-base URL     Download release artifacts from this directory
  --version VERSION      Select a release (default: release/version)
  --prefix DIR           Choose a per-user installation directory
  --vscode               Install Thor, standard Odin/OLS and CodeLLDB
  --profile NAME         Create/use a named VS Code profile
  --colors / --no-colors  Enable/disable Thor colors for a NEW profile
  --code PATH            Select the VS Code CLI
  --code-user-data DIR   Use separate editor user data
  --extensions-dir DIR   Use separate extension storage
  --path                 Add a managed user PATH entry
  --from-source          Build pinned sources locally (requires build tools)
  --odin PATH            Reuse a reviewed Odin for a source build
  --uninstall            Remove Thor; retain VS Code and developer tools
  --doctor               Verify the installed toolchain and editor services
  --no-install-deps      Do not install missing system prerequisites
  --dry-run              Verify the distribution without installing
  --help                 Show this overview
Existing editor settings, profiles and project configurations are preserved.
--vscode builds pinned native upstream OLS and adds its managed server setting.
Without a published GitHub release, use --bundle or --release-base.
Older macOS versions use a native source build when the published SDK is too new.
HELP
        exit 0;; esac
done
# A newline-delimited argument file is safe here because all installer argument
# values reject newline/control characters. Rebuild positional args without eval.
: > "$forward/args"
while [ "$#" -gt 0 ]; do
    arg=$1; shift
    case "$arg" in
        --from-source) from_source=true;;
        --portable-bundle) portable_bundle=true; printf '%s\n' "$arg" >> "$forward/args";;
        --no-install-deps) no_deps=true; printf '%s\n' "$arg" >> "$forward/args";;
        --odin) [ "$#" -gt 0 ] || { echo '--odin requires a value' >&2; exit 1; }; reuse_odin=true; printf '%s\n%s\n' "$arg" "$1" >> "$forward/args"; shift;;
        --vscode) editor=true; printf '%s\n' "$arg" >> "$forward/args";;
        --code) [ "$#" -gt 0 ] || { echo '--code requires a value' >&2; exit 1; }; custom_code=true; printf '%s\n%s\n' "$arg" "$1" >> "$forward/args"; shift;;
        --uninstall|--doctor) maintenance=$arg; printf '%s\n' "$arg" >> "$forward/args";;
        --dry-run) dry=true; printf '%s\n' "$arg" >> "$forward/args";;
        --prefix) [ "$#" -gt 0 ] || { echo '--prefix requires a value' >&2; exit 1; }; prefix=$1; printf '%s\n%s\n' "$arg" "$1" >> "$forward/args"; shift;;
        --release-base|--version|--bundle|--sha256)
            [ "$#" -gt 0 ] || { echo "thor-install: $arg requires a value" >&2; exit 1; }
            case "$arg" in --release-base) base=$1;; --version) version=$1;; --bundle) bundle=$1;; --sha256) checksum=$1;; esac
            shift;;
        *) case "$arg" in *'
'*) echo 'thor-install: newline in argument' >&2; exit 1;; esac
           printf '%s\n' "$arg" >> "$forward/args";;
    esac
done
case "$version" in ''|*[!a-zA-Z0-9._-]*) echo 'thor-install: invalid version' >&2; exit 1;; esac
case "$(uname -s)" in Darwin) os=macos;; Linux) os=linux;; FreeBSD) os=freebsd;; NetBSD) os=netbsd;; OpenBSD) os=openbsd;; *) echo 'thor-install: use thor-install.cmd on Windows' >&2; exit 1;; esac
machine=$(uname -m)
if [ "$machine" = evbarm ]; then machine=$(uname -p); fi
case "$machine" in arm64|aarch64) arch=aarch64;; x86_64|amd64) arch=x86_64;; *) echo 'thor-install: unsupported architecture' >&2; exit 1;; esac
source_install() {
    PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/pkg/bin:$PATH"; export PATH
    python=
    for candidate in python3 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 /usr/bin/python3; do
        if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3,9))' >/dev/null 2>&1; then python=$candidate; break; fi
    done
    [ -n "$python" ] || { echo 'Source installation requires Python 3.9+. Install it and rerun.' >&2; exit 1; }
    set --; while IFS= read -r arg; do set -- "$@" "$arg"; done < "$forward/args"
    "$python" "$root/install/from_source.py" "$@"
}
source_prerequisites() {
    set -- --source
    if $reuse_odin; then set -- "$@" --reuse-odin; fi
    if $portable_bundle; then set -- "$@" --portable-bundle; fi
    if $editor && ! $custom_code; then set -- "$@" --vscode; fi
    sh "$root/install/prerequisites.sh" "$@"
}
# Maintenance uses the installed native installer, copied away from files that
# uninstall will remove. It never downloads a release or provisions software.
if [ -n "$maintenance" ]; then
    $from_source && { echo '--from-source cannot be used with maintenance' >&2; exit 1; }
    [ -z "$bundle$checksum" ] || { echo 'Maintenance cannot use --bundle/--sha256' >&2; exit 1; }
    if [ -z "$prefix" ]; then
        case "$os" in macos) prefix="$HOME/Library/Application Support/Thor";; *) prefix="${XDG_DATA_HOME:-$HOME/.local/share}/thor";; esac
        case "$os" in macos) record="$HOME/Library/Application Support/Thor/installation.json";; *) record="${XDG_CONFIG_HOME:-$HOME/.config}/thor/installation.json";; esac
        if [ -f "$record" ]; then
            # Native records use pretty JSON and installation paths reject
            # quotes/backslashes/control characters. No eval or shell expansion.
            installed_root=$(sed -n 's/^ *"root": "\([^"]*\)",\{0,1\}$/\1/p' "$record")
            if [ -n "$installed_root" ] && [ -f "$installed_root/thor-install" ]; then
                cp "$installed_root/thor-install" "$forward/installed-installer"; chmod 700 "$forward/installed-installer"
                set --; while IFS= read -r arg; do set -- "$@" "$arg"; done < "$forward/args"
                "$forward/installed-installer" "$@"; exit $?
            fi
        fi
    fi
    native="$prefix/bin/thor-install"
    if [ ! -f "$native" ]; then
        if [ "$maintenance" = --uninstall ]; then echo 'Thor is not installed at this prefix.'; exit 0; fi
        echo "No installed Thor at $prefix" >&2; exit 1
    fi
    cp "$native" "$forward/installed-installer"; chmod 700 "$forward/installed-installer"
    set --; while IFS= read -r arg; do set -- "$@" "$arg"; done < "$forward/args"
    "$forward/installed-installer" "$@"; exit $?
fi
# The published SDK includes LLVM libraries whose deployment target can be
# newer than Thor's Rust executables. Select a native source build before
# downloading that SDK. A custom release base or local bundle has its own
# compatibility policy; --from-source also bypasses this release-only floor.
if ! $from_source && [ "$os" = macos ] && [ -z "$base$bundle" ] && [ "$version" = "$(cat "$root/release/version")" ]; then
    minimum=$(cat "$root/release/macos-minimum")
    current=$(sw_vers -productVersion)
    if ! awk -v current="$current" -v minimum="$minimum" 'BEGIN {
        split(current, a, "."); split(minimum, b, ".");
        for (i=1; i<=3; i++) {
            if (a[i]+0 > b[i]+0) exit 0;
            if (a[i]+0 < b[i]+0) exit 1;
        }
        exit 0;
    }'; then
        echo "Published macOS bundles require macOS $minimum or newer (this Mac: $current); using a native source build."
        from_source=true
    fi
fi
if $from_source; then
    [ -z "$bundle$checksum" ] || { echo '--from-source cannot use --bundle/--sha256' >&2; exit 1; }
    [ "$version" = "$(cat "$root/release/version")" ] || { echo 'A source build uses the checked-out version. Check out the requested release first.' >&2; exit 1; }
    # --dry-run must not install Python/Rust or change the checkout.
    if $dry; then echo 'Source install plan: acquire pinned build tools/Odin, build Thor/TLS/editor, verify and install; no changes made.'; exit 0; fi
    if ! $no_deps; then source_prerequisites; fi
    source_install; exit $?
fi
# Reject an unsupported system before downloading an installer its loader
# cannot start. Custom bundles/source builds have their own compatibility policy.
if [ "$os" = linux ] && [ -z "$base$bundle" ] && [ "$version" = "$(cat "$root/release/version")" ] && [ -f "$root/release/linux-compatibility.json" ]; then
    minimum=$(sed -n 's/^ *"glibc": "\([0-9.]*\)".*/\1/p' "$root/release/linux-compatibility.json")
    libc=$(getconf GNU_LIBC_VERSION 2>/dev/null || :)
    current=${libc#glibc }
    if [ -z "$minimum" ] || [ "$current" = "$libc" ] || ! awk -v current="$current" -v minimum="$minimum" 'BEGIN {
        if(current !~ /^[0-9]+[.][0-9]+$/) exit 1;
        split(current,a,".");split(minimum,b,".");
        exit !(a[1]+0>b[1]+0 || (a[1]+0==b[1]+0 && a[2]+0>=b[2]+0));
    }'; then
        echo "Published Linux bundles require glibc $minimum or newer (this system: ${libc:-not GNU libc}). Use a supported distribution or an explicitly configured --from-source build." >&2
        exit 1
    fi
fi
if [ -z "$bundle" ]; then
    if ! $no_deps && ! $dry; then sh "$root/install/prerequisites.sh" --download-only; fi
    if [ -z "$base" ]; then
        origin=$(git -C "$root" remote get-url origin 2>/dev/null || :)
        case "$origin" in https://github.com/*) slug=${origin#https://github.com/};; git@github.com:*) slug=${origin#git@github.com:};; *) slug=;; esac
        slug=${slug%.git}
        case "$slug" in */*) base="https://github.com/$slug/releases/download/v$version";; *) echo 'thor-install: no release location is configured. Use --bundle FILE or --release-base URL until GitHub releases are published.' >&2; exit 1;; esac
    fi
    case "$base" in https://*) ;; http://localhost:*|http://127.0.0.1:*|http://\[::1\]:*) ;; *) echo 'thor-install: release URLs must use HTTPS (localhost HTTP is supported for testing)' >&2; exit 1;; esac
    command -v curl >/dev/null 2>&1 || { echo 'thor-install: install curl and CA certificates first' >&2; exit 1; }
    bundle="$forward/thor-$version-$os-$arch.tar.gz"
    echo "Downloading $base/$(basename "$bundle")"
    status=$(curl --location --proto '=https,http' --proto-redir '=https' --write-out '%{http_code}' "$base/$(basename "$bundle")" -o "$bundle")
    if [ "$status" = 404 ]; then
        [ "$version" = "$(cat "$root/release/version")" ] || { echo 'No binary for this version. Check out that release before building it from source.' >&2; exit 1; }
        if $dry; then echo 'No prebuilt release: source-build fallback would be used; no changes made.'; exit 0; fi
        echo 'No release binary exists for this host; building the checked-out source.'
        if ! $no_deps; then source_prerequisites; fi
        source_install; exit $?
    fi
    case "$status" in 2??) ;; *) echo "Release download failed (HTTP $status); no source fallback on transport errors." >&2; exit 1;; esac
    if [ -z "$checksum" ]; then
        curl --fail --location --proto '=https,http' --proto-redir '=https' "$base/$(basename "$bundle").sha256" -o "$bundle.sha256"
    fi
fi
if [ -z "$checksum" ]; then checksum=$(awk 'NR == 1 {print $1}' "$bundle.sha256"); fi
case "$checksum" in ''|*[!a-fA-F0-9]*) echo 'thor-install: invalid SHA-256' >&2; exit 1;; esac
[ "${#checksum}" -eq 64 ] || { echo 'thor-install: invalid SHA-256 length' >&2; exit 1; }
if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$bundle" | awk '{print $1}'); else actual=$(shasum -a 256 "$bundle" | awk '{print $1}'); fi
expected=$(printf '%s' "$checksum" | tr 'A-F' 'a-f')
[ "$actual" = "$expected" ] || { echo 'thor-install: bundle SHA-256 mismatch; nothing installed' >&2; exit 1; }
# Stream only the named executable into a private temporary file. Do not extract
# arbitrary archive paths before the native installer validates the inventory.
tar -xOzf "$bundle" thor-install > "$forward/thor-install"
chmod 700 "$forward/thor-install"
if $editor && ! $custom_code && ! $no_deps && ! $dry && [ -f "$root/install/prerequisites.sh" ] && [ -f "$root/install/vscode-minimum" ]; then
    # The checkout may contain newer prerequisite fixes than a published native
    # bundle. Validate/upgrade the editor before handing off to that bundle.
    sh "$root/install/prerequisites.sh" --vscode
fi
set --
while IFS= read -r arg; do set -- "$@" "$arg"; done < "$forward/args"
"$forward/thor-install" --bundle "$bundle" --sha256 "$expected" "$@"
