{
  "name": "thor-language",
  "displayName": "Thor Language",
  "description": "Thor language tools, TLS, and source-mapped CodeLLDB debugging.",
  "publisher": "thor-local",
  "version": "0.20.1",
  "icon": "images/emblem.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:thor",
    "onDebugResolve:thor-lldb",
    "onTaskType:thor-debug-build"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available; TLS runs only in trusted workspaces."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "thor",
        "aliases": [
          "Thor",
          "thor"
        ],
        "extensions": [
          ".thor"
        ],
        "icon": {
          "light": "./fileicons/thor-file-light.svg",
          "dark": "./fileicons/thor-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "thor",
        "scopeName": "source.thor",
        "path": "./syntaxes/thor.tmLanguage.json",
        "unbalancedBracketScopes": [
          "comment",
          "string.quoted.double.thor",
          "string.quoted.single.thor",
          "string.quoted.raw.thor",
          "meta.interpolation.literal.thor",
          "constant.character.escape",
          "invalid.illegal.unknown-escape.thor"
        ]
      }
    ],
    "snippets": [
      {
        "language": "thor",
        "path": "./snippets/thor.json"
      }
    ],
    "commands": [
      {
        "command": "tls.restart",
        "title": "Thor: Restart Language Server"
      },
      {
        "command": "thor.refreshBracketHighlighting",
        "title": "Thor: Refresh Bracket Highlighting"
      },
      {
        "command": "thor.run",
        "title": "Thor: Run Project"
      },
      {
        "command": "thor.debug",
        "title": "Thor: Debug Project"
      },
      {
        "command": "thor.previewConstantColor",
        "title": "Thor: Preview Compile-Time Constant Color"
      },
      {
        "command": "thor.restoreConstantColor",
        "title": "Thor: Restore Previous Constant Color"
      }
    ],
    "configuration": {
      "title": "Thor",
      "properties": {
        "tls.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the local TLS language server."
        },
        "tls.server.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "TLS executable. Defaults to the Thor installation at THOR_ROOT or ~/Thor, or the current toolchain checkout. Relative paths resolve against the workspace."
        },
        "tls.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Thor compiler launcher for live compiler diagnostics. Defaults to thor alongside the TLS checkout; relative paths resolve against the workspace."
        },
        "tls.odinRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Odin root directory for core/base/vendor imports."
        },
        "tls.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace TLS protocol messages in the output panel."
        }
      }
    },
    "configurationDefaults": {
      "[thor]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.formatOnSave": false
      }
    },
    "semanticTokenScopes": [
      {
        "language": "thor",
        "scopes": {
          "namespace": [
            "variable.other.namespace.thor"
          ],
          "parameter.readonly": [
            "variable.other.constant.thor"
          ],
          "label": [
            "entity.name.label.thor"
          ]
        }
      }
    ],
    "keybindings": [
      {
        "command": "thor.run",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "editorLangId == thor && !inDebugMode"
      },
      {
        "command": "thor.debug",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == thor && !inDebugMode"
      }
    ],
    "taskDefinitions": [
      {
        "type": "thor-debug-build",
        "required": ["directory"],
        "properties": {
          "directory": {"type": "string", "description": "Thor source directory to build for debugging."}
        }
      }
    ],
    "breakpoints": [
      {
        "language": "thor"
      }
    ],
    "debuggers": [
      {
        "type": "thor-lldb",
        "label": "Thor (CodeLLDB)",
        "languages": [
          "thor"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "manifest"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Native executable produced by the Thor debug build."
              },
              "manifest": {
                "type": "string",
                "description": "thor-manifest.json from the matching debug build."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "terminal": {
                "type": "string",
                "enum": [
                  "console",
                  "integrated",
                  "external"
                ],
                "default": "console"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expressions": {
                "type": "string",
                "enum": [
                  "simple",
                  "native",
                  "python"
                ],
                "default": "simple"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Thor: Debug Project",
            "body": {
              "name": "Debug Thor (LLDB)",
              "type": "thor-lldb",
              "request": "launch",
              "program": "${workspaceFolder}/.vscode/bin/debug",
              "manifest": "${workspaceFolder}/.vscode/bin/generated/thor-manifest.json",
              "cwd": "${workspaceFolder}",
              "args": [],
              "preLaunchTask": "build-thor-debug"
            }
          }
        ]
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "thorCompileTime",
        "description": "Compile-time value constant, separate from runtime immutable storage."
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links -o thor-language.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "vscode-textmate": "^9.0.0",
    "vscode-oniguruma": "^2.0.1"
  }
}
