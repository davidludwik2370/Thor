{
  "Conditional compilation": {
    "prefix": "#if",
    "body": [
      "#if ${1:CONDITION} {",
      "\t$2",
      "} #else {",
      "\t$0",
      "}"
    ],
    "description": "Thor compile-time branch"
  },
  "Selective import": {
    "prefix": "importsel",
    "body": "import \"${1:core:fmt}\" / ${2:println}",
    "description": "File-local selected import"
  },
  "Multiline ternary": {
    "prefix": "ternary",
    "body": [
      "${1:condition} ? ${2:first_value}",
      "    : ${3:second_value}"
    ],
    "description": "Thor multiline ternary expression"
  },
  "Constrained generic procedure": {
    "prefix": "procwhere",
    "body": [
      "${1:numeric} :: proc(x: \\$T) -> T where T in [${2:int, f64}] {",
      "\t${0:return x}",
      "}"
    ],
    "description": "Generic procedure with exact type membership"
  },
  "Immutable storage": {
    "prefix": "imm",
    "body": [
      "${1:name} :> ${2:value}"
    ],
    "description": "Runtime-initialized immutable storage"
  },
  "Interpolated string": {
    "prefix": "fstr",
    "body": [
      "f\"${1:text} {${2:value}}\""
    ],
    "description": "Interpolated string; anonymous call arguments are freed after the expression"
  },
  "Switch expression": {
    "prefix": "switchexpr",
    "body": [
      "switch ${1:value} {",
      "\tcase ${2:match}: ${3:expression}",
      "\tcase: ${4:default_expression}",
      "}"
    ],
    "description": "Switch expression with a default result"
  },
  "Set literal": {
    "prefix": "setlit",
    "body": [
      "set[${1:int}]{${2:elements}}"
    ],
    "description": "Caller-owned Set literal"
  },
  "Pure function": {
    "prefix": "fn",
    "body": [
      "${1:square} :: fn(${2:value}: ${3:int}) -> ${3:int} {",
      "\t${0:return value * value}",
      "}"
    ],
    "description": "Declared pure function with compiler-managed scratch storage"
  },
  "Explicit compile-time call": {
    "prefix": "run",
    "body": [
      "#run ${1:function}(${2:arguments})"
    ],
    "description": "Evaluate a direct eligible call at compile time"
  },
  "Typed numeric range": {
    "prefix": "fort",
    "body": ["for ${1:i}: ${2:int} in ${3:0}..<${4:count} {", "\t$0", "}"],
    "description": "Numeric range with an explicit iteration type"
  },
  "Typed array or slice index": {
    "prefix": "forindex",
    "body": ["for ${1:value}, (${2:index}: ${3:u8}) in ${4:values} {", "\t$0", "}"],
    "description": "Infer the element type and use a checked integer index type"
  },
  "Manual-lifetime interpolated string": {
    "prefix": "fkeep",
    "body": [
      "f!\"${1:text} {${2:value}}\""
    ],
    "description": "Interpolated string with explicit manual temporary ownership"
  }
}
