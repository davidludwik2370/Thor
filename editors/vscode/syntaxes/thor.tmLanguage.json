        {
          "name": "constant.numeric.thor",
          "match": "\\b(\\d(\\d|_)*(\\.\\d(\\d|_)*)?)((e|E)(\\+|-)?\\d+)?[ijk]?\\b"
        },
        {
          "name": "constant.numeric.thor",
          "match": "\\b((0b(0|1|_)+)|(0o(\\d|_)+)|(0d(\\d|_)+)|(0[xXh](\\h|_)+))[i]?\\b"
        },
        {
          "name": "storage.type.thor",
          "match": "\\b(struct|enum|union|map|bit_set|bit_field|matrix)\\b"
        },
        {
          "name": "keyword.operator.assignment.compound.thor",
          "match": "[+\\-*/%]=|%%="
        },
        {
          "name": "keyword.operator.assignment.compound.bitwise.thor",
          "match": "\\|=|~=|&~?=|<<=|>>="
        },
        {
          "name": "keyword.operator.comparison.thor",
          "match": "==|!="
        },
        {
          "name": "keyword.operator.relational.thor",
          "match": "[<>]=?"
        },
        {
          "name": "keyword.operator.range.thor",
          "match": "\\.\\.[<=]"
        },
        {
          "name": "keyword.operator.spread.thor",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.thor",
          "match": ":[:=]|="
        },
        {
          "name": "keyword.operator.address.thor",
          "match": "&"
        },
        {
          "name": "keyword.operator.address.thor",
          "match": "\\^"
        },
        {
          "match": "->",
          "name": "storage.type.function.arrow.thor"
        },
        {
          "name": "keyword.operator.thor",
          "match": "@|(\\||\\!|:|\\+|-|\\*|/|%|\\<\\<?|\\>\\>?|\\~)=?|=|: : ?|\\$"
        },
        {
          "name": "entity.name.tag.thor",
          "match": "#[A-Za-z_]\\w*"
        }
      ]
    },
    "basic-types": {
      "patterns": [
        {
          "name": "support.type.primitive.thor",
