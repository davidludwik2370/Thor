    "immutable-assignment": {
      "name": "meta.definition.variable.immutable.thor",
      "match": "(?:([A-Za-z_]\\w*)\\s*(,)\\s*)?(?:([A-Za-z_]\\w*)\\s*(,)\\s*)?([A-Za-z_]\\w*)\\s*(:\\s*>)",
      "captures": {
