      "patterns": [
        {
          "include": "#set-type"
        },
        {
          "include": "#assignments"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "return-type-declaration": {
      "name": "meta.return.type.thor",
      "begin": "->",
      "beginCaptures": {
        "0": {
          "name": "storage.type.function.arrow.thor"
        }
      },
      "end": "(?=^|\\)|,|;|{|where)",
      "patterns": [
        {
          "include": "#set-type"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#basic-types"
        },
        {
          "include": "#property-access"
        },
        {
          "name": "meta.parameters.thor",
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.begin.thor"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.thor"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#assignments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#basic-types"
            },
            {
              "include": "#property-access"
            },
            {
