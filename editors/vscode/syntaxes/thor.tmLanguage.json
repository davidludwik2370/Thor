    "attribute": {
      "patterns": [
        {
          "name": "meta.attribute.thor",
          "match": "(@)\\s*([A-Za-z_]\\w*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.attribute.thor"
            },
            "2": {
              "name": "entity.other.attribute-name.thor"
            }
          }
        },
        {
          "name": "meta.attribute.thor",
          "begin": "(@)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.attribute.thor"
            },
            "2": {
              "name": "meta.brace.round.thor"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "meta.brace.round.thor"
            }
          },
          "patterns": [
            {
              "match": "\\b([A-Za-z_]\\w*)\\b",
              "name": "entity.other.attribute-name.thor"
            },
            {
              "match": ",",
              "name": "punctuation.thor"
            },
            {
              "begin": "=",
              "beginCaptures": {
                "0": {
                  "name": "keyword.operator.assignment.thor"
                }
              },
              "end": "(?=,|\\))",
              "patterns": [
                {
                  "include": "#expressions"
                }
              ]
            }
          ]
        }
      ]
    },
    "procedure-assignment": {
      "name": "meta.definition.variable.thor",
      "begin": "\\b([A-Za-z_]\\w*)\\s*(:\\s*:|=)\\s*(#\\w+)?\\s*(?=(?:proc|fn)\\b)",
      "beginCaptures": {
        "1": {
          "name": "meta.definition.function.thor entity.name.function.thor"
