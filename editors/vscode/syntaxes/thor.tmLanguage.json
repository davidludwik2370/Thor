      "end": "(?=^)|(?<=\\})",
      "patterns": [
        {
          "include": "#type-declaration"
        }
      ]
    },
    "type-assignment": {
      "name": "meta.definition.variable.thor",
      "begin": "\\b([A-Za-z_]\\w*)\\s*(:\\s*:)\\s*(?=(struct|union|enum|bit_set|bit_field)\\b)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.thor"
        },
        "2": {
          "name": "keyword.operator.assignment.thor"
        },
        "3": {
          "name": "storage.type.thor"
        }
