    "immutable-type-assignment": {
      "name": "meta.type.annotation.immutable.thor",
      "begin": "([A-Za-z_]\\w*)\\s*(:)(?=[^=\\n]*(?<!-)>(?!=))",
      "beginCaptures": {
        "1": {
          "name": "variable.other.readonly.thor"
        },
        "2": {
          "name": "keyword.operator.type.annotation.thor"
