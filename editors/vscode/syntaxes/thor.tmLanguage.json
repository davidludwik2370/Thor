    "strings": {
      "patterns": [
        {
          "include": "#interpolated-strings"
        },
        {
          "name": "string.quoted.double.thor",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.thor"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.thor"
            }
