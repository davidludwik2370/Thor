    "string-escaped-char": {
      "patterns": [
        {
          "name": "constant.character.escape.ansi-color-sequence.thor",
          "match": "\\\\(x1b|e|033)\\[[0-9;]*m"
        },
        {
          "name": "constant.character.escape.thor",
          "match": "\\\\(\\\\|[abefnrutv''\"]|x\\h{2}|u\\h{4}|U\\h{8}|[0-7]{3})"
        },
        {
          "name": "constant.character.escape.placeholders.thor",
          "match": "%(v|w|T|%|t|b|c|r|o|d|i|z|x|X|U|e|E|f|F|g|G|h|H|m|M|s|q|x|X|p|p|s)"
        },
