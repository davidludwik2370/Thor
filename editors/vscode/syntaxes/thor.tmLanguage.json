  "repository": {
    "file-tags": {
      "name": "comment.line.double-slash.thor",
      "begin": "#\\+[A-Za-z_][A-Za-z0-9_\\-]*",
      "beginCaptures": {
        "0": {
          "name": "entity.name.tag.thor"
        }
      },
      "patterns": [
        {
          "name": "punctuation.thor",
          "match": ","
        },
        {
          "name": "keyword.operator.logical.thor",
          "match": "!"
        },
        {
          "name": "entity.other.attribute-name.thor",
          "match": "[A-Za-z_][A-Za-z0-9_\\-]*"
        }
      ],
      "end": "\n"
    },
    "package-name-declaration": {
      "match": "^\\s*(package)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.control.thor"
        },
        "2": {
          "name": "entity.name.type.module.thor"
        }
      }
    },
    "import-declaration": {
      "match": "\\b(import)\\b(?:\\s+([A-Za-z_]\\w*)(?=\\s+[\"`]))?",
      "captures": {
        "1": {
          "name": "keyword.control.import.thor"
        },
        "2": {
          "name": "entity.name.namespace.thor"
        }
      }
    },
    "statements": {
      "patterns": [
        {
          "include": "#attribute"
