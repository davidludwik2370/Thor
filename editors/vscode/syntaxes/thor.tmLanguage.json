        "3": {
          "name": "variable.name.thor"
        },
        "4": {
          "name": "punctuation.thor"
        },
        "5": {
          "name": "variable.name.thor"
        },
        "6": {
          "name": "keyword.operator.type.annotation.thor"
        }
      },
      "end": "(?=^|,|;|\\)|=|:|for|switch|if|{)",
      "patterns": [
        {
          "include": "#set-type"
        },
        {
          "include": "#type-declaration"
        }
      ]
    },
    "object-definition": {
      "name": "meta.object.type.thor",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.thor"
        }
