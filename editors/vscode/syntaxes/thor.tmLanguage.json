          "beginCaptures": {
            "1": {
              "name": "storage.type.thor"
            }
          },
          "end": "(?=^|\\)|,|;)|(?<=})",
          "patterns": [
            {
              "include": "#parameters"
            },
            {
              "include": "#return-type-declaration"
            },
            {
              "include": "#object-definition"
            },
            {
              "include": "#expressions"
            }
          ]
        },
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#block-definition"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#basic-types"
        },
        {
          "include": "#slice"
        },
        {
          "begin": "\\(",
          "beginCaptures": {
