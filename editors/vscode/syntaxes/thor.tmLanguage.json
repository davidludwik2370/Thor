    "variable-assignment": {
      "name": "meta.definition.variable.thor",
      "match": "(?:([A-Za-z_]\\w*)\\s*(,)\\s*)?(?:([A-Za-z_]\\w*)\\s*(,)\\s*)?([A-Za-z_]\\w*)\\s*(:\\s*=)",
      "captures": {
        "1": {
          "name": "variable.name.thor"
        },
        "2": {
          "name": "punctuation.thor"
        },
        "3": {
          "name": "variable.name.thor"
        },
        "4": {
          "name": "punctuation.thor"
        },
        "5": {
          "name": "variable.name.thor"
        },
        "6": {
          "name": "keyword.operator.assignment.thor"
        }
      }
    },
    "type-annotation": {
      "name": "meta.type.annotation.thor",
      "begin": "(?:([A-Za-z_]\\w*)\\s*(,)\\s*)?(?:([A-Za-z_]\\w*)\\s*(,)\\s*)?([A-Za-z_]\\w*)\\s*(:)",
